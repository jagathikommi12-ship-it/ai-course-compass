# Server-side only. NEVER commit the real values, and never send the
# service_role key or JWT secret to the frontend or Gradio app.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Only needed if your project is still on Supabase's legacy shared HS256
# secret (Settings > API > JWT Settings > JWT Secret). Projects on the newer
# JWT Signing Keys system (default for new projects) can leave this blank —
# verification instead uses the project's public JWKS endpoint. See app/auth.py.
SUPABASE_JWT_SECRET=

ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of origins allowed to call this API
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:7860
